# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local tool/runtime caches
/.npm-cache/
/.runtime-data/
/.dev-server.log
/.dev-server-error.log
/src/generated/prisma/


# Previous Git metadata backup
/.git-codex-backup/
